# orch runtime — local tooling, never checked in
.orchestrator/
# Task worktrees live next to the project, in ../<project>.worktrees/.
# This keeps the ones an older orch left inside it out of git.
.worktrees/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Python (in case you also have Python here)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# atomize backups stay local
tasks.json.bak-*

# Node / pnpm
node_modules/
dist/
build/
.next/

# Go

# Generated code (F0.3.T3+, F0.7.T1+)
packages/ts-contracts/src/gen/
libs/go/oe/gen/
apps/admin-web/src/nav/index.ts

# Environment
.env.local
.env*.local

# Development
/tmp/

# go work sync / go test regenerate this per checkout
go.work.sum
*.tsbuildinfo
.turbo/
# dev-only secrets generated by scripts/dev-secrets.sh
deploy/compose/.secrets/
# Playwright output
tests/e2e/test-results/
tests/e2e/playwright-report/

# make up creates it from .env.example and fills in dev secrets
deploy/compose/.env
