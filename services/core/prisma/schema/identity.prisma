// core → identity (arch "Data model", FR-1, FR-2, FR-6, NFR-8).
//
// IDs are UUID v7 generated by `identity.uuid_v7()` (created in the first migration).
// Every business table carries `tenant_id`; it is null only for rows of the platform
// operator. Row level security (policies, FORCE RLS, append-only audit_log) and the
// case-insensitive email index live in hand-written SQL in the migration, since Prisma
// cannot express them.

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
  @@schema("identity")
}

enum Locale {
  es
  pt
  en

  @@map("locale")
  @@schema("identity")
}

// "locked" in the API is derived from `locked_until`, so it is not stored.
enum UserStatus {
  invited
  active
  disabled

  @@map("user_status")
  @@schema("identity")
}

enum PermissionAction {
  view
  edit
  launch
  admin

  @@map("permission_action")
  @@schema("identity")
}

enum ActorType {
  user
  client
  service

  @@map("actor_type")
  @@schema("identity")
}

model Tenant {
  id            String       @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  name          String
  timezone      String
  defaultLocale Locale       @default(es) @map("default_locale")
  limits        Json         @default("{}")
  status        TenantStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  users            User[]
  roles            Role[]
  rolePermissions  RolePermission[]
  userRoles        UserRole[]
  apiClients       ApiClient[]
  refreshTokens    RefreshToken[]
  invitations      Invitation[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@map("tenants")
  @@schema("identity")
}

// Unique (tenant_id, lower(email)) NULLS NOT DISTINCT is in the migration SQL.
model User {
  id           String     @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId     String?    @map("tenant_id") @db.Uuid
  email        String
  name         String?
  passwordHash String?    @map("password_hash")
  // Encrypted with CORE_ENCRYPTION_KEY; MFA is on only once `mfa_enabled` is set.
  mfaSecret    String?    @map("mfa_secret")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  locale       Locale     @default(es)
  status       UserStatus @default(active)
  failedLogins Int        @default(0) @map("failed_logins")
  lockedUntil  DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  invitations      Invitation[]
  mfaRecoveryCodes MfaRecoveryCode[]

  @@map("users")
  @@schema("identity")
}

model Role {
  id        String   @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  name      String
  // Default roles (Admin, Marketer, Viewer) cannot be deleted.
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
  @@schema("identity")
}

// `module` is one of PERMISSION_MODULES (src/modules/identity-shared/permissions.ts).
model RolePermission {
  roleId   String           @map("role_id") @db.Uuid
  tenantId String?          @map("tenant_id") @db.Uuid
  module   String
  action   PermissionAction

  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([roleId, module, action])
  @@map("role_permissions")
  @@schema("identity")
}

model UserRole {
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("identity")
}

model ApiClient {
  id         String    @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  clientId   String    @unique @map("client_id")
  name       String
  secretHash String    @map("secret_hash")
  scopes     String[]
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_clients")
  @@schema("identity")
}

// Opaque rotating refresh tokens; reuse of a rotated token revokes its whole family.
model RefreshToken {
  id        String    @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("identity")
}

model Invitation {
  id         String    @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  roleIds    String[]  @map("role_ids") @db.Uuid
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invitations")
  @@schema("identity")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
  @@schema("identity")
}

// Append-only: the migration revokes UPDATE, DELETE and TRUNCATE from `core`. No foreign
// keys, so entries outlive the tenant, user or resource they describe.
model AuditLog {
  id           String    @id @default(dbgenerated("identity.uuid_v7()")) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  actorType    ActorType @map("actor_type")
  actorId      String    @map("actor_id")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String?   @map("resource_id")
  diff         Json?
  ip           String?
  at           DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, at(sort: Desc)])
  @@map("audit_log")
  @@schema("identity")
}
