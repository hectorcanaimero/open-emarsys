// Client for prisma-tenant.spec.ts only. Generated into node_modules so it is never committed.
generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma-tenant-test"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_TEST_DATABASE_URL")
}

model Item {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  @@map("items")
}
