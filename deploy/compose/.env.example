# Copiar a deploy/compose/.env y ajustar. Todas las contraseñas son solo para
# desarrollo local; en cualquier otro entorno deben venir de un secret manager.

# Perfiles de `make up`. `localdb` levanta Postgres, Redis, ClickHouse y Temporal en
# local; quitalo (y fijá OE_PG_HOST & cía.) para usar servidores externos.
COMPOSE_PROFILES=core,data,obs,localdb

# --- PostgreSQL (perfil localdb) ---
# Postgres externo: OE_PG_HOST, OE_PG_HOST_PORT y OE_PG_DB, con los roles creados por
# deploy/postgres/init/00-roles.sql. OE_PG_POOL = conexiones máximas por servicio (5).
OE_PG_PORT=5432
OE_PG_DB=oe
OE_PG_ADMIN_USER=oe_admin
OE_PG_ADMIN_PASSWORD=change-me-admin

# Un password por rol/servicio (ver deploy/postgres/init/00-roles.sql, NFR-8).
OE_PG_CORE_PASSWORD=change-me-core
OE_PG_IMPORTER_PASSWORD=change-me-importer
OE_PG_SEGMENTS_PASSWORD=change-me-segments
OE_PG_CONTENT_PASSWORD=change-me-content
OE_PG_CAMPAIGNS_PASSWORD=change-me-campaigns
OE_PG_DISPATCHER_PASSWORD=change-me-dispatcher
OE_PG_AUTOMATION_PASSWORD=change-me-automation
OE_PG_ML_PASSWORD=change-me-ml
OE_PG_ANALYTICS_PASSWORD=change-me-analytics
OE_PG_LOYALTY_PASSWORD=change-me-loyalty
OE_PG_CONNECTORS_PASSWORD=change-me-connectors
OE_PG_TEMPORAL_PASSWORD=change-me-temporal

# --- Redis (perfiles core, data, ai) ---
OE_REDIS_PORT=6379

# --- MinIO (perfiles core, data, ai) ---
MINIO_ROOT_USER=oe_minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit (perfil core) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- core (perfil core) ---
# Rutas ABSOLUTAS en el host. Generar una vez (legibles por uid 1001 del contenedor):
#   mkdir -p /abs/path/jwt && openssl genrsa -out /abs/path/jwt/k1.pem 2048 && chmod 644 /abs/path/jwt/k1.pem
#   echo '{"segments":{"secret":"change-me","scopes":["contacts:view"]}}' > /abs/path/service-credentials.json
CORE_JWT_KEYS_DIR=/abs/path/to/jwt
CORE_SERVICE_CREDENTIALS=/abs/path/to/service-credentials.json
# 32 bytes en base64: openssl rand -base64 32
CORE_ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32
# importer -> core (client_id importer); scripts/dev-secrets.sh generates it and adds it to
# the service credentials core reads.
IMPORTER_SERVICE_SECRET=change-me

# --- seed (make seed, F0.8.T3) ---
# Contraseñas de dev (>= 12 caracteres, no comunes). El operador se crea con
# `pnpm --filter @oe/core cli create-operator`, que necesita DATABASE_URL de core.
OE_CORE_URL=http://localhost:3001
OE_MAILPIT_URL=http://localhost:8025
OE_OPERATOR_EMAIL=operator@open-emarsys.local
OE_OPERATOR_PASSWORD=change-me-operator-pw
OE_DEMO_ADMIN_PASSWORD=change-me-demo-admin-pw
OE_DEMO_MARKETER_PASSWORD=change-me-demo-marketer-pw
OE_DEMO_VIEWER_PASSWORD=change-me-demo-viewer-pw
