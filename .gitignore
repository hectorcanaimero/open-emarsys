# orch runtime — local tooling, never checked in
.orchestrator/
# Task worktrees live next to the project, in ../<project>.worktrees/.
# This keeps the ones an older orch left inside it out of git.
.worktrees/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Python (in case you also have Python here)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# atomize backups stay local
tasks.json.bak-*

# Node / pnpm
node_modules/
dist/
build/

# Go
go.sum

# Generated code (F0.3.T3+)
packages/ts-contracts/src/gen/
libs/go/oe/gen/
scripts/codegen/nav.ts

# Environment
.env.local
.env*.local

# Development
/tmp/

# go work sync / go test regenerate this per checkout
go.work.sum
