{
  "name": "@oe/core",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema"
  },
  "scripts": {
    "generate": "if grep -qs '^model ' prisma/schema/*.prisma; then DATABASE_URL=\"${DATABASE_URL:-postgresql://core:core@localhost:5432/oe}\" prisma generate --schema prisma/schema; else echo 'no Prisma models yet; skipping prisma generate'; fi",
    "prebuild": "pnpm run generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "cli": "tsx src/cli/main.ts",
    "pretypecheck": "pnpm run generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run generate",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@oe/ts-common": "workspace:*",
    "@prisma/client": "^5.22.0",
    "commander": "^12.1.0",
    "jose": "^5.9.6",
    "nats": "^2.29.1",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "testcontainers": "^10.13.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
